{
  "format": "tishka-skill/1",
  "id": "friday-morning",
  "name": "Утро пятницы",
  "description": "Открывает страницы, нужные для начала пятницы",
  "phrases": ["утро пятницы", "начинаем пятницу"],
  "trigger": { "type": "manual" },
  "inputs": [
    {
      "name": "mail_page",
      "description": "Адрес почты",
      "required": false,
      "default": "https://example.org/friday"
    },
    {
      "name": "plan_page",
      "description": "Адрес страницы с планом на день",
      "required": false,
      "default": "https://example.org/plan"
    }
  ],
  "steps": [
    {
      "id": "open",
      "tool": "open_urls",
      "args": {
        "urls": ["{{inputs.mail_page}}", "{{inputs.plan_page}}"]
      }
    },
    {
      "id": "done",
      "say": "Открыл всё для пятницы"
    }
  ]
}
