{
  "format": "tishka-skill/1",
  "id": "watch-page",
  "name": "Следи за страницей",
  "description": "Сообщает, когда версия страницы изменилась",
  "phrases": [],
  "requires": ["confluence"],
  "trigger": {
    "type": "watch",
    "tool": "confluence__get_page_version",
    "args": { "page_id": "{{inputs.page_id}}" },
    "everyMinutes": 2,
    "field": "version"
  },
  "inputs": [
    { "name": "page_id", "description": "Номер страницы Confluence", "required": true, "default": "123456" }
  ],
  "steps": [
    { "id": "page", "tool": "confluence__get_page_version", "args": { "page_id": "{{inputs.page_id}}" } },
    {
      "id": "changed",
      "say": "Страница обновилась",
      "show": {
        "kind": "text",
        "title": "Страница обновилась",
        "markdown": "Новая версия: {{steps.page.data.version}}\n\nСсылка: {{steps.page.data.url}}"
      }
    }
  ]
}
